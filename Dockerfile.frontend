FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY --chown=101:101 frontend /usr/share/nginx/html
COPY --chmod=755 --chown=101:101 frontend/docker-entrypoint-parksmart.sh /docker-entrypoint.d/40-parksmart-config.sh

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -q -O - http://127.0.0.1:8080/ >/dev/null 2>&1 || exit 1
