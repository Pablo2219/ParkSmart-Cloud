# ============================================================
# ParkSmart - Variables locales de ejemplo
# Nunca subir .env al repositorio.
# ============================================================

ENVIRONMENT=local
LOG_LEVEL=INFO
ROOT_PATH=

SECRET_KEY=parksmart-local-secret-key-change-me
JWT_SECRET=parksmart-local-jwt-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_MINUTES=15
AUTH_DEBUG_RESET_TOKEN=false

PRIVACY_POLICY_VERSION=1.0
TERMS_VERSION=1.0
DATA_CONTROLLER_NAME=ParkSmart
DATA_CONTROLLER_CONTACT=privacidad@parksmart.local

CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:3000,http://localhost:3000
FRONTEND_URL=http://127.0.0.1:5500

DATABASE_URL=mysql+pymysql://parksmart_app:parksmart_local@localhost:3307/parksmart
MIGRATION_DATABASE_URL=mysql+pymysql://parksmart_migrator:parksmart_migrator_local@localhost:3307/parksmart
DATABASE_CA_CERT=

MYSQL_DATABASE=parksmart
MYSQL_USER=parksmart_app
MYSQL_PASSWORD=parksmart_local
MYSQL_MIGRATION_USER=parksmart_migrator
MYSQL_MIGRATION_PASSWORD=parksmart_migrator_local
MYSQL_ROOT_PASSWORD=parksmart_root

NOTIFICATION_MODE=SIMULATION
DEFAULT_PHONE_COUNTRY_CODE=+506

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Facturación externa: dejar vacío para simulación local
BILLING_MODE=SIMULATION
BILLING_API_URL=
BILLING_API_KEY=
BILLING_API_TIMEOUT_SECONDS=10
