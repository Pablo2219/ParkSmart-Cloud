# ============================================================
# ParkSmart - Variables locales de ejemplo
# Copiar como .env y reemplazar únicamente los valores CAMBIAR_*
# Nunca subir .env al repositorio.
# ============================================================

ENVIRONMENT=local
LOG_LEVEL=INFO
ROOT_PATH=

# Seguridad de la aplicación
SECRET_KEY=CAMBIAR_SECRET_KEY_64_CARACTERES
JWT_SECRET=CAMBIAR_JWT_SECRET_64_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_MINUTES=15
AUTH_DEBUG_RESET_TOKEN=false

# Privacidad / Ley 8968
PRIVACY_POLICY_VERSION=1.0
DATA_CONTROLLER_NAME=ParkSmart
DATA_CONTROLLER_CONTACT=privacidad@parksmart.local

# CORS: lista separada por comas. En nube se reemplaza por la URL del frontend.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
FRONTEND_URL=http://127.0.0.1:5500

# Base de datos para ejecución local desde el host
DATABASE_URL=mysql+pymysql://parksmart_app:CAMBIAR_CONTRASENA_APP@localhost:3307/parksmart
MIGRATION_DATABASE_URL=mysql+pymysql://parksmart_migrator:CAMBIAR_CONTRASENA_MIGRACIONES@localhost:3307/parksmart
DATABASE_CA_CERT=

# MySQL local para Docker Compose
MYSQL_DATABASE=parksmart
MYSQL_USER=parksmart_app
MYSQL_PASSWORD=CAMBIAR_CONTRASENA_APP
MYSQL_MIGRATION_USER=parksmart_migrator
MYSQL_MIGRATION_PASSWORD=CAMBIAR_CONTRASENA_MIGRACIONES
MYSQL_ROOT_PASSWORD=CAMBIAR_CONTRASENA_ROOT

# Notificaciones
NOTIFICATION_MODE=SIMULATION
DEFAULT_PHONE_COUNTRY_CODE=+506
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
